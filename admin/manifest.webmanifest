{
  "name": "Portfolio Chat — Admin",
  "short_name": "Chat Admin",
  "description": "Reply in real time to visitors who message you from your portfolio, with push notifications on every device.",
  "id": "/admin/",
  "start_url": "/admin/?source=pwa",
  "scope": "/admin/",
  "display": "standalone",
  "orientation": "any",
  "lang": "en",
  "dir": "ltr",
  "categories": ["business", "productivity", "communication"],
  "background_color": "#f4f6fb",
  "theme_color": "#4f7cff",
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "screenshots": [
    {
      "src": "screenshots/desktop.webp",
      "sizes": "1280x573",
      "type": "image/webp",
      "form_factor": "wide",
      "label": "Inbox, conversation and customer details"
    },
    {
      "src": "screenshots/mobile-inbox.webp",
      "sizes": "478x784",
      "type": "image/webp",
      "form_factor": "narrow",
      "label": "Inbox on a phone"
    },
    {
      "src": "screenshots/mobile-chat.webp",
      "sizes": "478x784",
      "type": "image/webp",
      "form_factor": "narrow",
      "label": "Replying to a visitor"
    }
  ],
  "shortcuts": [
    {
      "name": "Unread chats",
      "short_name": "Unread",
      "url": "/admin/?filter=unread",
      "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Testimonials",
      "url": "/admin/?panel=testimonials",
      "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ]
}
